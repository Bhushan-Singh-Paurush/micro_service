generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttendaceLogs{
      id String @id @default(uuid())
      crop String
      timeStamp DateTime
      role Role
      camera_id String 
      status Status
}

enum Role{
  Entry
  Exit
}

enum Status{
  Present
  Absent
  Late
}


